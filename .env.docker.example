# =============================================================================
# Environment Configuration Template for BMO DeepAgent UI
# =============================================================================
# IMPORTANT: This is a TEMPLATE file. DO NOT commit your actual secrets here.
# 
# Instructions:
# 1. Copy this file to .env.docker: cp .env.docker.example .env.docker
# 2. Replace the placeholder values below with your actual API keys
# 3. The .env.docker file will be used during Docker build/deployment
#
# Alternative: Set environment variables directly in your deployment environment
# =============================================================================

# =============================================================================
# LANGCHAIN/LANGSMITH CONFIGURATION
# =============================================================================

# LangSmith API Key (required for connecting LangGraph server)
# Get your key at: https://smith.langchain.com/settings
LANGCHAIN_API_KEY="YOUR_LANGCHAIN_API_KEY_HERE"

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# A random secret used by NextAuth to encrypt the session
# Tip: You can generate a good random string for AUTH_SECRET by running `openssl rand -base64 32` in your terminal
AUTH_SECRET="YOUR_AUTH_SECRET_HERE"

# GitHub OAuth Configuration
# Register your app at: https://github.com/settings/applications/new
AUTH_GITHUB_ID="YOUR_GITHUB_CLIENT_ID_HERE"
AUTH_GITHUB_SECRET="YOUR_GITHUB_CLIENT_SECRET_HERE"

# Google OAuth Configuration
# Create credentials at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
AUTH_GOOGLE_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"

# =============================================================================
# LANGGRAPH CONFIGURATION
# =============================================================================

# LangGraph Server URL (Server-side - used by API proxy)
# This is required for the server-side proxy to forward requests
LANGGRAPH_URL="https://YOUR_LANGGRAPH_SERVER_URL_HERE"

# LangGraph Server URL (Client-side - exposed to browser)
# The endpoint where your LangGraph server is deployed
NEXT_PUBLIC_LANGGRAPH_URL="https://YOUR_LANGGRAPH_SERVER_URL_HERE"

# Assistant ID for the research agent
NEXT_PUBLIC_ASSISTANT_ID="research"

# =============================================================================
# AUTH.JS / NEXTAUTH CONFIGURATION
# =============================================================================

# Trust host configuration (set to true for production with proper HTTPS)
AUTH_TRUST_HOST=true

# Application URL (update with your actual deployment URL)
AUTH_URL="https://YOUR_APP_URL_HERE"
NEXTAUTH_URL="https://YOUR_APP_URL_HERE"