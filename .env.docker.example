# =============================================================================
# LangSmith API Key (required for connecting LangGraph server)
# Get your key at: https://smith.langchain.com/settings
# =============================================================================
LANGCHAIN_API_KEY="YOUR_LANGCHAIN_API_KEY_HERE"

# =============================================================================
# API Key for authentication
# =============================================================================
UPLOAD_API_KEY="YOUR_UPLOAD_API_KEY_HERE"

# LangGraph Configuration
# Client-side URL (exposed to browser)
NEXT_PUBLIC_LANGGRAPH_URL="https://YOUR_LANGGRAPH_SERVER_URL_HERE"
NEXT_PUBLIC_ASSISTANT_ID="research"

# Production passkey settings are owned by runtime deployment. Azure Container
# Apps resolves UI/backend URLs and references the proxy secret from Key Vault;
# do not duplicate those settings in this private build-time file.
