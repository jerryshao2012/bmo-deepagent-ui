# =============================================================================
# LangSmith API Key (required for connecting LangGraph server)
# Get your key at: https://smith.langchain.com/settings
# =============================================================================
LANGCHAIN_API_KEY="YOUR_LANGCHAIN_API_KEY_HERE"

# =============================================================================
# API Key for authentication
# =============================================================================
UPLOAD_API_KEY="YOUR_UPLOAD_API_KEY_HERE"

# LangGraph Configuration
# Client-side URL (exposed to browser)
NEXT_PUBLIC_LANGGRAPH_URL="https://YOUR_LANGGRAPH_SERVER_URL_HERE"
NEXT_PUBLIC_ASSISTANT_ID="research"

# =============================================================================
# Passkey BFF (disabled by default)
# =============================================================================
# Use exact UI origin, without a trailing slash. HTTP is accepted only on
# localhost/loopback during development.
PASSKEY_ENABLED=false
PASSKEY_ORIGIN="https://YOUR_UI_HOST_HERE"
PASSKEY_PROXY_ID="web-bff"
# Generate independently with a cryptographically secure generator. Configure
# the exact same value as PASSKEY_PROXY_SECRET on the backend; use Key Vault in
# Azure rather than committing it to an environment file.
# openssl rand -base64 48
PASSKEY_PROXY_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
