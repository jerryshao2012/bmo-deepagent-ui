{
  "name": "deep-agents-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.cjs",
    "build": "next build",
    "start": "node server.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:signin-animation": "node --import tsx --test tests/sign-in-fish-motion.test.ts",
    "test:remembered-login": "node --import tsx --test --test-isolation=none tests/remembered-login.test.ts tests/oauth-login.test.ts tests/login-providers.test.tsx tests/remembered-login-capture.test.tsx",
    "test:passkeys": "node --import tsx --test --test-isolation=none tests/auth-slice-boundaries.test.mjs tests/passkey-bff.test.ts tests/passkey-enrollment-state.test.ts tests/passkey-login.test.tsx tests/passkey-management.test.tsx",
    "test:thread-retention": "node --test tests/thread-retention.test.mjs",
    "test:markdown-images": "node --import tsx --test --test-isolation=none tests/markdown-attachment-types.test.ts tests/markdown-images.test.ts tests/synced-markdown-attachment.test.tsx",
    "test:state-file-links": "node --import tsx --test tests/markdown-state-file-links.test.tsx",
    "test:architecture": "node --test tests/architecture-boundaries.test.mjs tests/auth-slice-boundaries.test.mjs tests/chat-thread-boundaries.test.mjs tests/markdown-sync-architecture.test.mjs tests/platform-boundaries.test.mjs tests/wiki-skills-boundaries.test.mjs && node scripts/check-architecture.mjs",
    "test:chat-architecture": "node --test tests/chat-thread-boundaries.test.mjs",
    "test:platform": "node --test tests/platform-boundaries.test.mjs && node --import tsx --test --test-isolation=none tests/api-transport.test.ts tests/authenticated-fetch.test.ts",
    "contract:generate": "openapi-typescript contracts/backend-api.openapi.json -o src/generated/backend-api.ts",
    "contract:check": "openapi-typescript contracts/backend-api.openapi.json -o src/generated/backend-api.ts --check",
    "analyze:har": "node scripts/analyze-har.mjs",
    "postinstall": "mkdir -p public/pdfjs && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdfjs/"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.0.2",
    "@langchain/langgraph-sdk": "^1.9.25",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@radix-ui/colors": "^1.0.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@simplewebauthn/browser": "^13.3.0",
    "@types/diff": "^5.0.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^9.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "date-fns": "^4.1.0",
    "diff": "^8.0.3",
    "geist": "^1.7.2",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.23",
    "lucide-react": "^0.539.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.15.0",
    "next": "^16.1.7",
    "next-auth": "^5.0.0-beta.31",
    "nuqs": "^2.8.8",
    "pdfjs-dist": "^6.0.227",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "sass": "^1.90.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.6",
    "use-stick-to-bottom": "^1.1.1",
    "uuid": "^9.0.1",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@headlessui/tailwindcss": "^0.2.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9",
    "eslint-config-next": "16",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "packageManager": "yarn@4.18.0"
}
