#!/bin/bash
# =============================================================================
# Secrets Configuration for Deep Agent UI on Azure (Template)
# =============================================================================
# Copy this file to secrets.sh and fill in your actual values
# This script should be run before deploy.sh to populate Key Vault with actual secret values

source ./env.sh
source ./scripts/azure-subscription.sh

if ! command -v az >/dev/null 2>&1; then
  echo "❌ Required command not found: az"
  exit 1
fi

select_azure_subscription || exit $?
echo "Azure subscription: $AZURE_SUBSCRIPTION_ID"

echo "🔐 Setting secrets in Azure Key Vault: $KV_NAME"

# API Keys and authentication credentials (fill these in)
UPLOAD_API_KEY="YOUR_UPLOAD_API_KEY_HERE"
LANGCHAIN_API_KEY="YOUR_LANGSMITH_API_KEY_HERE"
AUTH_SECRET="YOUR_NEXTAUTH_SECRET_HERE" # Generate with: openssl rand -base64 32
AUTH_GITHUB_ID="YOUR_GITHUB_CLIENT_ID_HERE"
AUTH_GITHUB_SECRET="YOUR_GITHUB_CLIENT_SECRET_HERE"
AUTH_GOOGLE_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
AUTH_GOOGLE_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"

# Set all secrets in Key Vault
az keyvault secret set --vault-name $KV_NAME --name UPLOAD-API-KEY --value "$UPLOAD_API_KEY" > /dev/null && echo "  ✓ UPLOAD-API-KEY"
az keyvault secret set --vault-name $KV_NAME --name LANGCHAIN-API-KEY --value "$LANGCHAIN_API_KEY" > /dev/null && echo "  ✓ LANGCHAIN-API-KEY"
az keyvault secret set --vault-name $KV_NAME --name AUTH-SECRET --value "$AUTH_SECRET" > /dev/null && echo "  ✓ AUTH-SECRET"
az keyvault secret set --vault-name $KV_NAME --name AUTH-GITHUB-ID --value "$AUTH_GITHUB_ID" > /dev/null && echo "  ✓ AUTH-GITHUB-ID"
az keyvault secret set --vault-name $KV_NAME --name AUTH-GITHUB-SECRET --value "$AUTH_GITHUB_SECRET" > /dev/null && echo "  ✓ AUTH-GITHUB-SECRET"
az keyvault secret set --vault-name $KV_NAME --name AUTH-GOOGLE-ID --value "$AUTH_GOOGLE_ID" > /dev/null && echo "  ✓ AUTH-GOOGLE-ID"
az keyvault secret set --vault-name $KV_NAME --name AUTH-GOOGLE-SECRET --value "$AUTH_GOOGLE_SECRET" > /dev/null && echo "  ✓ AUTH-GOOGLE-SECRET"

echo "✅ All secrets have been set in Key Vault"
echo "💡 You can now run ./deploy.sh to deploy with these secrets"
